{
  "gateway": {
    "name": "DuckBot Docker MCP Gateway",
    "version": "1.0.0",
    "description": "Secure container-based MCP server management for DuckBot ecosystem",
    "auto_initialize": true,
    "fallback_mode": true
  },
  "docker": {
    "required": true,
    "check_availability": true,
    "fallback_to_local": true,
    "container_settings": {
      "network": "bridge",
      "restart_policy": "unless-stopped",
      "memory_limit": "1g",
      "cpu_limit": "0.5"
    }
  },
  "mcp_plugin": {
    "required": false,
    "auto_install": false,
    "install_command": "docker mcp install",
    "fallback_commands": {
      "list_servers": "docker ps --filter 'label=mcp.server' --format '{{.Names}}'",
      "start_server": "docker start {server_name}",
      "stop_server": "docker stop {server_name}",
      "remove_server": "docker rm -f {server_name}"
    }
  },
  "catalogs": {
    "default": "duckbot",
    "auto_sync": true,
    "sync_interval": 300,
    "catalogs": {
      "duckbot": {
        "name": "DuckBot Ecosystem",
        "description": "Official DuckBot MCP servers and tools",
        "url": "http://localhost:8000/catalog",
        "auth": null,
        "auto_update": true
      },
      "community": {
        "name": "Community MCP Servers",
        "description": "Community-contributed MCP servers",
        "url": "https://mcp-community.example.com/catalog",
        "auth": null,
        "auto_update": false
      }
    }
  },
  "servers": {
    "default_registry": {
      "image": "duckbot-mcp:latest",
      "port": 8000,
      "environment": {
        "DUCKBOT_MODE": "production",
        "LOG_LEVEL": "INFO"
      },
      "volumes": [
        "./logs:/app/logs",
        "./duckbot/config:/app/config"
      ],
      "secrets": [],
      "health_check": {
        "enabled": true,
        "endpoint": "/health",
        "interval": 30,
        "timeout": 10
      }
    },
    "auto_discovery": {
      "enabled": true,
      "interval": 60,
      "labels": {
        "mcp.server": "true",
        "mcp.version": "1.0"
      }
    },
    "health_monitoring": {
      "enabled": true,
      "check_interval": 30,
      "retry_count": 3,
      "auto_restart": true
    }
  },
  "tools": {
    "auto_discover": true,
    "cache_enabled": true,
    "cache_ttl": 300,
    "execution": {
      "timeout": 120,
      "max_retries": 3,
      "fallback_to_local": true,
      "parallel_execution": true,
      "max_concurrent": 5
    },
    "security": {
      "input_validation": true,
      "output_sanitization": true,
      "allowed_tools": ["*"],
      "blocked_tools": []
    }
  },
  "security": {
    "authentication": {
      "enabled": false,
      "type": "none",
      "api_key": null
    },
    "authorization": {
      "enabled": true,
      "default_permissions": ["read", "execute"],
      "tool_permissions": {}
    },
    "network": {
      "allowed_hosts": ["127.0.0.1", "localhost"],
      "port_range": "8000-9000",
      "enable_firewall": true
    },
    "container_security": {
      "read_only_filesystem": false,
      "drop_capabilities": true,
      "no_new_privileges": true,
      "user_namespace": true
    },
    "secrets": {
      "enabled": true,
      "storage": "docker_secrets",
      "auto_rotate": false,
      "rotation_interval": 86400
    }
  },
  "logging": {
    "level": "INFO",
    "file": "logs/docker_mcp_gateway.log",
    "max_size": "50MB",
    "backup_count": 10,
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "structured_logging": true,
    "include_timestamps": true,
    "log_execution": true,
    "log_errors": true
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "server_count": true,
      "tool_execution": true,
      "success_rate": true,
      "response_time": true,
      "resource_usage": true
    },
    "alerts": {
      "server_down": true,
      "high_error_rate": true,
      "resource_threshold": true
    },
    "dashboard": {
      "enabled": true,
      "port": 8001,
      "refresh_interval": 5
    }
  },
  "integration": {
    "duckbot_webui": {
      "enabled": true,
      "api_base": "http://localhost:8787",
      "websocket_endpoint": "/ws/docker-gateway",
      "auto_connect": true,
      "sync_status": true
    },
    "mcp_server": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8000,
      "auto_register": true
    }
  },
  "performance": {
    "connection_pool": {
      "enabled": true,
      "max_connections": 10,
      "timeout": 30
    },
    "caching": {
      "enabled": true,
      "server_list_ttl": 300,
      "tool_list_ttl": 180,
      "execution_results_ttl": 60
    },
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 100,
      "burst_limit": 150
    }
  },
  "backup": {
    "enabled": true,
    "interval": 86400,
    "retain_count": 7,
    "include_config": true,
    "include_server_state": false,
    "storage_location": "./backups/docker_mcp_gateway/"
  }
}
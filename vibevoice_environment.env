# Microsoft VibeVoice and RealtimeVoiceChat Environment Configuration
# Copy this file to .env and fill in your API keys

# VibeVoice Configuration
VIBEVOICE_API_URL=http://localhost:8000
ENABLE_VIBEVOICE=true

# AI Provider API Keys
# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# LM Studio Configuration (default settings)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local

# DuckBot Configuration
DUCKBOT_API_URL=local
DUCKBOT_MODEL=duckbot

# RealtimeVoiceChat Configuration
REALTIME_VOICECHAT_PORT=8001
REALTIME_VOICECHAT_HOST=0.0.0.0

# Discord Configuration (if using Discord bot)
DISCORD_TOKEN=your_discord_bot_token_here

# General Settings
ENABLE_LOGGING=true
LOG_LEVEL=INFO
TEMP_DIRECTORY=/tmp/vibevoice
CLEANUP_TEMP_FILES=true
CLEANUP_DELAY_HOURS=1

# Feature Flags
ENABLE_EMOTION_DETECTION=true
ENABLE_STYLE_TRANSFER=true
ENABLE_MULTI_SPEAKER=true
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_VOICE=true
ENABLE_WEB_INTERFACE=true
ENABLE_DISCORD_INTEGRATION=true

# Performance Settings
MAX_WORKERS=4
CACHE_SIZE=100
TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1
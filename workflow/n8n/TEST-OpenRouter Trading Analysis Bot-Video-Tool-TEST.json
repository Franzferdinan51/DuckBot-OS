# Build an n8n workflow JSON with the final Code node embedded, plus a Discord node.
import json, textwrap, os, uuid, time

workflow_name = "Trading News Video — WAN VACE 14B (ComfyUI → Discord)"
code_generate = r'''/** 
 * n8n Code node — ComfyUI API → Single Image → Video (WAN VACE 14B ref2v)
 * FINAL+POST-PROBE: waits for Comfy completion, THEN keeps probing disk until MP4 is served
 * --------------------------------------------------------------------------------------
 * Requirements: ComfyUI at http://127.0.0.1:8188, image in ComfyUI/input/DuckBotNewsAnchor7.png
 * Output: sets items[0].binary.video to the MP4 for Discord v2 (Binary Property = "video")
 */

const wait = (ms) => new Promise((r) => setTimeout(r, ms));
const randTag = () => `${Date.now()}_${Math.floor(Math.random()*1e6)}`;

const item = items[0] || { json: {}, binary: {} };
item.json = item.json || {};
item.binary = item.binary || {};

// ---------- config ----------
const CFG = {
  base: (item.json.comfyBase || 'http://127.0.0.1:8188').replace(/\/$/, ''),
  imageUri: item.json.imageUri || 'DuckBotNewsAnchor7.png',
  voice: item.json.voice || '[English] en-US Andrew',
  voiceSpeed: Number(item.json.voiceSpeed ?? 1),
  pitch: Number(item.json.pitch ?? 6),
  fps: Number(item.json.fps || 16),
  minSeconds: Number(item.json.minSeconds || 5),
  maxSeconds: Number(item.json.maxSeconds || 60),
  width: Number(item.json.width || 768),
  height: Number(item.json.height || 768),
  saveCodec: String(item.json.saveCodec || 'libx264'),
  pollMs: Number(item.json.pollMs || 2000),
  maxSleepMs: Number(item.json.maxSleepMs || 15000),
  waitForever: item.json.waitForever !== false, // default true
  maxPolls: Number(item.json.maxPolls || 0),
  maxWaitMs: Number(item.json.maxWaitMs || 0),
  strict: Boolean(item.json.strict ?? false),
  postProbeMaxMs: Number.isFinite(item.json.postProbeMaxMs) ? Number(item.json.postProbeMaxMs) : 600000, // 10m
  postProbeEveryMs: Number.isFinite(item.json.postProbeEveryMs) ? Number(item.json.postProbeEveryMs) : 5000,
};

function toInputFilename(v) {
  if (!v || typeof v !== 'string') return 'DuckBotNewsAnchor7.png';
  let s = v;
  if (s.toLowerCase().startsWith('file://')) s = s.slice(7);
  // normalize slashes
  while (s.includes('\\')) s = s.replace('\\','/');
  const parts = s.split('/');
  return parts.pop() || 'DuckBotNewsAnchor7.png';
}
function toComfyVoiceLabel(v) {
  if (!v || typeof v !== 'string') return '[English] en-US Andrew';
  if (v.startsWith('[')) return v; // already label format
  const m = v.match(/^([a-z]{2}\-[A-Z]{2})\-([A-Za-z]+)Neural$/);
  if (m) return `[English] ${m[1]} ${m[2]}`;
  return v;
}

const imageInputName = toInputFilename(CFG.imageUri);
const comfyVoice = toComfyVoiceLabel(CFG.voice);

// narration
const narration = (typeof item.json.output === 'string' && item.json.output.trim())
  ? item.json.output.trim()
  : "Good evening. Here's your latest crypto trading analysis.";

// auto-length from narration (2.6 words/sec × speed)
function estimateSeconds(text, minS, maxS, speed) {
  const words = text.trim().split(/\s+/).filter(Boolean).length || 1;
  const WPS = 2.6 * (speed > 0 ? speed : 1);
  const est = words / WPS;
  return Math.max(minS, Math.min(maxS, est));
}
const seconds = Number.isFinite(Number(item.json.targetSeconds))
  ? Number(item.json.targetSeconds)
  : estimateSeconds(narration, CFG.minSeconds, CFG.maxSeconds, CFG.voiceSpeed);
const frames = Math.max(24, Math.ceil(seconds * CFG.fps));

const jobTag = `news_${randTag()}`; // used in SaveVideo.filename_prefix

// ---------- Comfy graph (WAN VACE 14B ref2v + EdgeTTS + CreateVideo + SaveVideo) ----------
const graph = {
  // video backbone
  113: { inputs: { unet_name: 'wan2.1_vace_14B_fp16.safetensors', weight_dtype: 'default' }, class_type: 'UNETLoader', _meta: { title: 'Load Diffusion Model' } },
  127: { inputs: { clip_name: 'umt5_xxl_fp16.safetensors', type: 'wan', device: 'default' }, class_type: 'CLIPLoader', _meta: { title: 'Load CLIP' } },
  115: { inputs: { lora_name: 'Wan21_CausVid_14B_T2V_lora_rank32.safetensors', strength_model: 0.3, strength_clip: 1, model: [113,0], clip: [127,0] }, class_type: 'LoraLoader', _meta: { title: 'Load LoRA' } },
  110: { inputs: { shift: 8, model: [115,0] }, class_type: 'ModelSamplingSD3', _meta: { title: 'ModelSamplingSD3' } },
  114: { inputs: { vae_name: 'wan_2.1_vae.safetensors' }, class_type: 'VAELoader', _meta: { title: 'Load VAE' } },
  73:  { inputs: { image: imageInputName }, class_type: 'LoadImage', _meta: { title: 'Load Image' } },
  105: { inputs: { text: 'Professional Purple Sun duck news anchor in navy business suit, confident posture at news desk, animated speaking motion with subtle head movements and beak articulation, Purple Sun cosmic logo glowing behind, multiple LCD monitors displaying Bitcoin and crypto charts, financial newsroom setting, warm studio lighting, broadcast television quality, smooth animation, duck character maintaining professional demeanor while delivering crypto trading analysis.', clip: [115,1] }, class_type: 'CLIPTextEncode', _meta: { title: 'CLIP Text Encode (Positive Prompt)' } },
  107: { inputs: { text: 'distorted face, extra fingers, deformed hands, text, lower third, ticker, subtitles, logo, watermark, channel bug, UI overlay, chroma-key halo, green spill, fisheye, dutch angle, skewed horizon, lowres, blurry, oversharpen halos, banding, tiling, compression artifacts, bad perspective, heavy motion blur, ghosting, frame duplication', clip: [115,1] }, class_type: 'CLIPTextEncode', _meta: { title: 'CLIP Text Encode (Negative Prompt)' } },
  109: { inputs: { width: CFG.width, height: CFG.height, length: frames, batch_size: 1, strength: 1.0, positive: [105,0], negative: [107,0], vae: [114,0], reference_image: [73,0] }, class_type: 'WanVaceToVideo', _meta: { title: 'WanVaceToVideo' } },
  108: { inputs: { seed: 720080944430405, steps: 4, cfg: 1, sampler_name: 'uni_pc', scheduler: 'simple', denoise: 1, model: [110,0], positive: [109,0], negative: [109,1], latent_image: [109,2] }, class_type: 'KSampler', _meta: { title: 'KSampler' } },
  118: { inputs: { trim_amount: [109,3], samples: [108,0] }, class_type: 'TrimVideoLatent', _meta: { title: 'TrimVideoLatent' } },
  119: { inputs: { samples: [118,0], vae: [114,0] }, class_type: 'VAEDecode', _meta: { title: 'VAE Decode' } },

  // audio (EdgeTTS)
  171: { inputs: { value: narration }, class_type: 'String', _meta: { title: '📝 TTS Script Input' } },
  170: { inputs: { text: [171,0], voice: comfyVoice, speed: CFG.voiceSpeed, pitch: CFG.pitch }, class_type: 'EdgeTTS', _meta: { title: '🎤 Generate TTS Audio' } },
  169: { inputs: { filepath: 'tts_narration', format: 'mp3', quality: 'high', overwrite: false, audio: [170,0] }, class_type: 'Save_Audio', _meta: { title: '💾 Save TTS Audio' } },

  // mux + save
  68:  { inputs: { fps: CFG.fps, images: [119,0], audio: [170,0] }, class_type: 'CreateVideo', _meta: { title: 'Create Video' } },
  69:  { inputs: { filename_prefix: 'video/' + jobTag, format: 'mp4', codec: CFG.saveCodec, 'video-preview': '', video: [68,0] }, class_type: 'SaveVideo', _meta: { title: 'Save Video' } }
};

// contextualize the motion to the narration but avoid on-screen text
graph[105].inputs.text += '\n\nScript (context only, do NOT render text): {{ $json.output }}\nNarration (verbatim, do not draw): ' + narration;

// ---------- HTTP helpers ----------
async function httpJson(opts) {
  return this.helpers.httpRequest({ method: opts.method || 'GET', url: CFG.base + opts.path, qs: opts.qs, body: opts.body, json: true });
}
async function httpBuffer(url) {
  return this.helpers.httpRequest({ method: 'GET', url, encoding: null });
}
async function tryDownload(file) {
  const url = CFG.base + '/view?filename=' + encodeURIComponent(file.filename) + '&type=' + encodeURIComponent(file.type || 'output') + '&subfolder=' + encodeURIComponent(file.subfolder || '');
  try {
    const data = await httpBuffer.call(this, url);
    const mime = (file.filename.toLowerCase().endsWith('.mp4')) ? 'video/mp4' : 'application/octet-stream';
    return this.helpers.prepareBinaryData(data, file.filename, mime);
  } catch { return null; }
}

// ---------- submit prompt ----------
const client_id = (globalThis.crypto?.randomUUID && crypto.randomUUID()) || (Date.now() + '_' + Math.floor(Math.random()*1e6));
const post = await httpJson.call(this, { method: 'POST', path: '/prompt', body: { prompt: graph, client_id } });
const prompt_id = post?.prompt_id; if (!prompt_id) throw new Error('ComfyUI: missing prompt_id');

// ---------- poll until completed ----------
let slept = CFG.pollMs, polls = 0, t0 = Date.now();
while (true) {
  await wait(slept);
  const hist = await httpJson.call(this, { method: 'GET', path: '/history/' + prompt_id });
  const status = hist?.[prompt_id]?.status || {};
  if (status.completed) break;
  if (String(status.status_str || '').toLowerCase() === 'error') throw new Error('ComfyUI job error: ' + status.status_str);
  slept = Math.min(CFG.maxSleepMs, Math.ceil(slept * 1.3));
  polls++;
  if (!CFG.waitForever) {
    if (CFG.maxPolls > 0 && polls > CFG.maxPolls) throw new Error('Timed out (poll limit)');
    if (CFG.maxWaitMs > 0 && Date.now() - t0 > CFG.maxWaitMs) throw new Error('Timed out (time cap)');
  }
}

// ---------- collect outputs & attempt to fetch MP4 ----------
const history = await httpJson.call(this, { method: 'GET', path: '/history/' + prompt_id });
const outputs = history?.[prompt_id]?.outputs || {};
const files = [];
for (const nodeId of Object.keys(outputs)) {
  const nodeOut = outputs[nodeId] || {};
  for (const key of Object.keys(nodeOut)) {
    const arr = Array.isArray(nodeOut[key]) ? nodeOut[key] : [];
    for (const f of arr) if (f?.filename) files.push({ fromNode: nodeId, key, filename: f.filename, subfolder: f.subfolder || '', type: f.type || 'output', ext: (f.filename.split('.').pop() || '').toLowerCase() });
  }
}

let mp4 = files.find(f => f.fromNode === '69' && f.ext === 'mp4') || files.find(f => f.ext === 'mp4');
let videoBin = null;
if (mp4) videoBin = await tryDownload.call(this, mp4);

// ---------- post-completion probing (disk may lag) ----------
if (!videoBin) {
  const guesses = [ jobTag + '-00001.mp4', jobTag + '-00000.mp4', jobTag + '-001.mp4', jobTag + '-01.mp4', jobTag + '.mp4' ];
  const start = Date.now();
  while (!videoBin && (Date.now() - start) < CFG.postProbeMaxMs) {
    for (const name of guesses) {
      const got = await tryDownload.call(this, { filename: name, subfolder: 'video', type: 'output' });
      if (got) { videoBin = got; mp4 = { filename: name, subfolder: 'video', type: 'output' }; break; }
    }
    if (videoBin) break;
    await wait(CFG.postProbeEveryMs);
  }
}

if (!videoBin) {
  item.json.hints = [
    'MP4 not served yet or SaveVideo failed.',
    'History listed: ' + (files.filter(f=>f.ext==='mp4').map(f=>f.filename).join(', ') || '(none)'),
    'Probed for up to ' + Math.round(CFG.postProbeMaxMs/1000) + 's under /output/video: ' + jobTag + '-*.mp4',
    'Check: image at ComfyUI/input/' + imageInputName,
    'Check: SaveVideo codec ' + CFG.saveCodec + ' (try libx264) & ffmpeg installed',
    'Try smaller res/FPS: ' + CFG.width + 'x' + CFG.height + ' @ ' + CFG.fps
  ];
  if (CFG.strict) throw new Error('No MP4 produced/served by ComfyUI.');
} else {
  item.binary.video = videoBin; // what Discord v2 should upload (Binary Property = "video")
}

// optional: attach audio if present
const mp3 = files.find(f => f.ext === 'mp3');
if (mp3) {
  try { const a = await tryDownload.call(this, mp3); if (a) item.binary.audio = a; } catch {}
}

// telemetry
item.json.prompt_id = prompt_id;
item.json.image_used = imageInputName;
item.json.voice_used = comfyVoice;
item.json.job_tag = jobTag;
item.json.autoSizing = { seconds: Number(seconds.toFixed(2)), fps: CFG.fps, frames, width: CFG.width, height: CFG.height };
item.json.files = files;

return [item];
'''

code_guard = r'''// Quick Guard: ensure binary.video is present before Discord
const b = items[0]?.binary || {};
if (!b.video) {
  throw new Error('Discord upload blocked: binary.video is missing. Did Comfy finish and produce an MP4?');
}
return items;
'''

# Build nodes
nodes = [
    {
        "parameters": {},
        "id": "1",
        "name": "Manual Trigger",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [ -840, -60 ]
    },
    {
        "parameters": {
            "values": {
                "string": [
                    { "name": "output", "value": "Good evening. Here's your latest crypto trading analysis. Bitcoin holds strong momentum. Qubic shows spicy volatility — stay nimble." }
                ],
                "number": [
                    { "name": "fps", "value": 16 },
                    { "name": "width", "value": 768 },
                    { "name": "height", "value": 768 }
                ],
                "boolean": [
                    { "name": "waitForever", "value": True }
                ]
            },
            "options": {}
        },
        "id": "2",
        "name": "Set Narration & Settings",
        "type": "n8n-nodes-base.set",
        "typeVersion": 2,
        "position": [ -610, -60 ]
    },
    {
        "parameters": {
            "language": "JavaScript",
            "jsCode": code_generate
        },
        "id": "3",
        "name": "generate_news_video",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [ -360, -60 ]
    },
    {
        "parameters": {
            "language": "JavaScript",
            "jsCode": code_guard
        },
        "id": "4",
        "name": "Quick Guard",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [ -120, -60 ]
    },
    {
        "parameters": {
            "resource": "message",
            "operation": "send",
            "channelId": "REPLACE_WITH_CHANNEL_ID",
            "additionalFields": {
                "content": "🟣 Purple Sunshine — Crypto news clip",
                # Attachments in Discord v2: try both structures; user can adjust if needed
                "attachmentsUi": {
                    "attachments": [
                        { "binaryPropertyName": "video", "name": "news.mp4" }
                    ]
                }
            }
        },
        "id": "5",
        "name": "Discord v2 — Send",
        "type": "n8n-nodes-base.discordV2",
        "typeVersion": 1,
        "position": [ 140, -60 ],
        "credentials": {
            # User must configure these after import
            # "discordOAuth2Api": { "id": "xxx", "name": "Discord OAuth2 API" }
        }
    }
]

connections = {
    "Manual Trigger": { "main": [ [ { "node": "Set Narration & Settings", "type": "main", "index": 0 } ] ] },
    "Set Narration & Settings": { "main": [ [ { "node": "generate_news_video", "type": "main", "index": 0 } ] ] },
    "generate_news_video": { "main": [ [ { "node": "Quick Guard", "type": "main", "index": 0 } ] ] },
    "Quick Guard": { "main": [ [ { "node": "Discord v2 — Send", "type": "main", "index": 0 } ] ] }
}

workflow = {
    "name": workflow_name,
    "nodes": nodes,
    "connections": connections,
    "active": False,
    "settings": {},
    "staticData": None,
    "pinData": {},
    "version": 2
}

out_path = "/mnt/data/trading-news-video-wanvace-n8n.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(workflow, f, ensure_ascii=False, indent=2)

out_path

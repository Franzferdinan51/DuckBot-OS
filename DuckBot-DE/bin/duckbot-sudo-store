#!/usr/bin/env bash
# Store sudo password securely for non-interactive sudo
# Usage: echo 'password' | duckbot-sudo-store -

set -euo pipefail

TARGET="$HOME/.duckbot_sudo"
umask 077

if [ "${1:-}" = "-" ]; then
  # Read from stdin
  pw=$(cat -)
else
  echo "duckbot-sudo-store: read password from stdin (use '-')" >&2
  exit 1
fi

# Trim trailing newline
pw=${pw%$'\n'}
pw=${pw%$'\r'}

printf "%s" "$pw" > "$TARGET"
chmod 600 "$TARGET"
echo "[SUDO] Stored password to $TARGET (600 permissions)"


#!/usr/bin/env bash
# Run a command with sudo using stored password at ~/.duckbot_sudo
# Usage: duckbot-sudo-run "apt update"  or  duckbot-sudo-run bash -lc "apt update"

set -euo pipefail

PWFILE="$HOME/.duckbot_sudo"
[ -f "$PWFILE" ] || { echo "duckbot-sudo-run: password file not found ($PWFILE). Use duckbot-sudo-store." >&2; exit 1; }

cmd="$*"
if [ -z "$cmd" ]; then
  echo "duckbot-sudo-run: missing command" >&2
  exit 1
fi

sudo -S -p "" bash -lc "$cmd" < "$PWFILE"


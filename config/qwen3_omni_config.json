{
  "qwen3_omni": {
    "model_id": "./models/Qwen3-Omni-30B-A3B-Instruct",
    "device": "auto",
    "dtype": "auto",
    "use_flash_attention": true,
    "max_memory": {
      "gpu": "24GB",
      "cpu": "32GB"
    },
    "max_length": 32768,
    "temperature": 0.7,
    "top_p": 0.9,
    "repetition_penalty": 1.1,
    "do_sample": true,
    "cache_dir": null,
    "trust_remote_code": true,
    "use_fast_tokenizer": true,
    "load_in_8bit": false,
    "load_in_4bit": false,
    "device_map": "auto"
  },
  "voice_assistant": {
    "enabled": true,
    "sample_rate": 16000,
    "channels": 1,
    "chunk_size": 1024,
    "audio_format": "wav",
    "silence_threshold": 0.01,
    "silence_duration": 1.0,
    "max_recording_duration": 30.0,
    "tts_model_id": "facebook/mms-tts-eng",
    "voice_profile": "default",
    "enable_noise_reduction": true,
    "enable_voice_commands": true,
    "wake_word": "hey duckbot",
    "language": "en-US"
  },
  "multimodal": {
    "image_processing": {
      "enabled": true,
      "max_image_size": 1024,
      "supported_formats": ["jpg", "jpeg", "png", "bmp", "tiff"]
    },
    "audio_processing": {
      "enabled": true,
      "supported_formats": ["wav", "mp3", "flac", "m4a"],
      "max_duration": 300
    },
    "video_processing": {
      "enabled": false,
      "max_duration": 60,
      "fps": 30
    }
  },
  "memory_management": {
    "auto_unload": true,
    "unload_threshold": 3600,
    "max_memory_usage": 0.8,
    "garbage_collection_interval": 300
  },
  "performance": {
    "batch_processing": true,
    "batch_size": 1,
    "streaming": true,
    "cache_responses": true,
    "cache_ttl": 3600
  },
  "fallback": {
    "enabled": true,
    "providers": ["lm_studio", "qwen_agent", "claude_code", "zai_claude"],
    "timeout_threshold": 30,
    "max_retries": 3
  }
}
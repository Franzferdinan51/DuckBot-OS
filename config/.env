# DuckBot Environment Configuration

# OpenRouter API Key (for Qwen-Agent and Claude Code)
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=DuckBot-v4.2-Enhanced

# ZAI API Key (for Claude Code ZAI integration)
# Get a free API key at https://z.ai/
ZAI_API_KEY=your_zai_api_key_here

# Qwen Code Model Configuration
QWEN_CODE_MODEL=qwen/qwen3-coder:free
QWEN_CODE_MAX_TOKENS=4000
QWEN_CODE_TEMPERATURE=0.1

# Claude Code Configuration
CLAUDE_CODE_MODEL=anthropic/claude-3.5-sonnet:free
CLAUDE_CODE_MAX_TOKENS=4000
CLAUDE_CODE_TEMPERATURE=0.1

# DuckBot Core Configuration
DUCKBOT_LOG_LEVEL=INFO
DUCKBOT_DATA_DIR=./data
DUCKBOT_CONFIG_DIR=./config

# MCP Server Configuration
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=127.0.0.1

# WSL Integration
WSL_ENABLED=true
WSL_DEFAULT_DISTRO=Ubuntu

# Docker MCP Gateway
DOCKER_MCP_ENABLED=true
DOCKER_MCP_PORT=8080

# Browser-Use Configuration
BROWSER_USE_HEADLESS=false
BROWSER_USE_BROWSER_TYPE=chrome
BROWSER_USE_TIMEOUT=30

# Web-UI Configuration
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=7860

# Persona Engine Configuration
PERSONA_ENGINE_HOST=127.0.0.1
PERSONA_ENGINE_PORT=8788
PERSONA_ENGINE_CHARACTER_MODEL=aria
PERSONA_ENGINE_VOICE_MODEL=default
PERSONA_ENGINE_ENABLE_ANIMATION=true
PERSONA_ENGINE_ENABLE_SPEECH=true
PERSONA_ENGINE_ENABLE_EMOTIONS=true
# Dockerfile for DuckBot MCP Server
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgconf-2-4 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy DuckBot source code
COPY duckbot/ ./duckbot/

# Create non-root user
RUN useradd -m -u 1000 duckbot && chown -R duckbot:duckbot /app
USER duckbot

# Expose MCP server port
EXPOSE 8000

# Environment variables
ENV PYTHONPATH=/app
ENV DUCKBOT_MCP_SERVER=1
ENV DUCKBOT_CONTAINERIZED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Start MCP server
CMD ["python", "-m", "duckbot.integrations.mcp_server"]
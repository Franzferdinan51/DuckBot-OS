{
  "model_path": "hf:meta-llama/Llama-2-7b-chat-hf",
  "model_type": "hf_transformers",
  "training_method": "lora",
  "dataset_path": "datasets/sample_dataset.json",
  "output_dir": "trained_models/llama2_finetuned",
  "epochs": 3,
  "learning_rate": 3e-4,

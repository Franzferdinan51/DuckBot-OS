{
  "model_training": {
    "default_model_type": "hf_transformers",
    "default_training_method": "lora",
    "models_directory": "models/",
    "datasets_directory": "datasets/",
    "output_directory": "trained_models/",
    "max_concurrent_trainings": 1,
    "default_epochs": 3,
    "default_learning_rate": 3e-4,
    "default_batch_size": 4,
    "default_lora_r": 8,
    "default_lora_alpha": 16,
    "default_max_seq_length": 512,
    "enable_hf_upload": false,
    "hf_token": null
  },
  "supported_models": {
    "gguf": {
      "extensions": [".gguf"],
      "trainer": "llama.cpp",
      "description": "GGUF quantized models for efficient training"
    },
    "hf_transformers": {
      "extensions": [".bin", ".safetensors"],
      "trainer": "transformers",
      "description": "Hugging Face transformer models"
    }
  },
  "training_methods": {
    "lora": {
      "name": "LoRA",
      "description": "Low-Rank Adaptation for efficient fine-tuning",
      "parameters": {
        "r": 8,
        "alpha": 16,
        "dropout": 0.1
      }
    },
    "full_fine_tune": {
      "name": "Full Fine-tuning",
      "description": "Full model fine-tuning",
      "parameters": {}
    },
    "distillation": {
      "name": "Knowledge Distillation",
      "description": "Distill knowledge from a teacher model",
      "parameters": {
        "temperature": 2.0
      }
    }
  }
}
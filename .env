# DuckBot Enhanced v4.2 - Environment Configuration
# ========================================================
# This file contains all API keys and configuration settings
# for the AI provider system. Copy this file to .env.local
# and fill in your actual API keys.

# AI Provider Configuration
# ========================
# Default provider to use when not specified
DEFAULT_AI_PROVIDER=lm_studio

# Enable local-only mode (no external API calls)
AI_LOCAL_ONLY_MODE=false

# LM Studio Configuration (Local AI)
# =================================
# LM Studio server must be running locally
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3-30b-a3b-thinking-2507-deepseek-v3.1-distill
LM_STUDIO_ENABLED=true

# OpenRouter Configuration (Cloud AI)
# ==================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENROUTER_ENABLED=true

# Gemini Configuration (Google AI)
# ================================
# Get your API key from https://makersuite.google.com/app/apikey
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_MODEL=gemini-pro
#GEMINI_ENABLED=true

# DuckBot Configuration (Internal AI)
# ===================================
DUCKBOT_URL=http://localhost:8799
DUCKBOT_ENABLED=true

# VibeVoice TTS Configuration
# ==========================
ENABLE_VIBEVOICE=true
VIBEVOICE_API_URL=http://localhost:8000
VIBEVOICE_MODEL=microsoft/VibeVoice-1.5B
VIBEVOICE_MAX_TEXT_LENGTH=2000
VIBEVOICE_OUTPUT_DIR=output/vibevoice

# Ollama Configuration (Alternative Local AI)
# ===========================================
OLLAMA_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false

# AI System Settings
# ==================
AI_CONFIDENCE_MIN=0.75
AI_LOCAL_CONF_MIN=0.68
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.2
AI_CONVERSATION_HISTORY_LIMIT=50
AI_DECISION_CONFIDENCE_THRESHOLD=0.7

# Cost Management Settings
# ========================
AI_DAILY_BUDGET_LIMIT=10.0
AI_MONTHLY_BUDGET_LIMIT=100.0
AI_ENABLE_BUDGET_ALERTS=true
AI_ENABLE_COST_OPTIMIZATION=true
AI_COST_TRACKING_ENABLED=true

# Routing and Fallback Settings
# ==============================
AI_ENABLE_SMART_ROUTING=true
AI_ENABLE_COST_AWARENESS=true
AI_ROUTING_TYPE=smart
AI_MAX_FALLBACK_ATTEMPTS=3
AI_ENABLE_CIRCUIT_BREAKER=true
AI_CIRCUIT_BREAKER_THRESHOLD=5

# Caching Settings
# ================
AI_ENABLE_CACHING=true
AI_CACHE_TTL_SECONDS=300

# Monitoring Settings
# ==================
AI_MONITORING_ENABLED=true
AI_MONITORING_INTERVAL=30
AI_REPORT_INTERVAL=300
AI_DASHBOARD_PORT=8790

# Discord Integration
# ==================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_ENABLED=false

# Feature Toggles
# ===============
ENABLE_VIDEO_FEATURES=false
ENABLE_VOICE_FEATURES=true
ENABLE_NOTEBOOK_FEATURES=true
ENABLE_WEBUI_FEATURES=true
ENABLE_DESKTOP_AUTOMATION=true
ENABLE_MULTI_AGENT_FRAMEWORK=true
ENABLE_MEMORY_SYSTEM=true
ENABLE_COST_VISUALIZATION=true

# Performance Settings
# ====================
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_RESOURCE_OPTIMIZATION=true
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Security Settings
# =================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ENABLE_REQUEST_LOGGING=true
LOG_LEVEL=INFO

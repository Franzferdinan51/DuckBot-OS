# VibeVoice TTS Configuration for DuckBot v4.2
# Copy these values to your .env file or set them as environment variables

# Enable VibeVoice integration
ENABLE_VIBEVOICE=true

# VibeVoice API server URL (default: localhost:8000)
VIBEVOICE_API_URL=http://localhost:8000

# VibeVoice model configuration
VIBEVOICE_MODEL=microsoft/VibeVoice-1.5B

# Maximum text length for generation
VIBEVOICE_MAX_TEXT_LENGTH=2000

# Output directory for generated audio files
VIBEVOICE_OUTPUT_DIR=output/vibevoice

# VibeVoice server configuration (if running local server)
VIBEVOICE_SERVER_HOST=localhost
VIBEVOICE_SERVER_PORT=8000
VIBEVOICE_SERVER_WORKERS=1

# Performance settings
VIBEVOICE_TIMEOUT=300
VIBEVOICE_MAX_DURATION=5400  # 90 minutes in seconds

# Feature flags
VIBEVOICE_ENABLE_EMOTIONS=true
VIBEVOICE_ENABLE_BATCH_PROCESSING=true
VIBEVOICE_ENABLE_PODCAST_GENERATION=true
VIBEVOICE_ENABLE_VOICE_VARIANTS=true

# Default voice settings
VIBEVOICE_DEFAULT_SPEAKERS=en-alice,en-carter
VIBEVOICE_DEFAULT_STYLE=conversational
VIBEVOICE_DEFAULT_LANGUAGE=en
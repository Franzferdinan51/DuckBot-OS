# Local-only configuration for DuckBot Enhanced - Auto-detected Hardware
LOCAL_ONLY_MODE=true
ENABLE_HARDWARE_DETECTION=true
HARDWARE_AUTO_OPTIMIZE=true
# Hardware limits will be auto-detected (RTX 3080 10GB + 128GB RAM detected)
MAX_VRAM_GB=auto
DISABLE_LARGE_MODELS=auto
AI_LOCAL_ONLY_MODE=true
DISABLE_OPENROUTER=true
ENABLE_LM_STUDIO_ONLY=true
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=nvidia_NVIDIA-Nemotron-Nano-9B-v2-GGUF/nvidia_NVIDIA-Nemotron-Nano-9B-v2-Q5_K_S.gguf
AI_CONFIDENCE_MIN=0.65
AI_LOCAL_CONF_MIN=0.60
MAX_MEMORY_THRESHOLD=75.0
DUCKBOT_WEBUI_HOST=127.0.0.1
DUCKBOT_WEBUI_PORT=8787
ENABLE_VIDEO_FEATURES=false
ENABLE_VOICE_FEATURES=true
ENABLE_NOTEBOOK_FEATURES=true